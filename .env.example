# Copy to .env. Never commit .env or real credentials.
# Local Ollama vision + scan-aware Q&A. Pull this model before starting the backend:
# ollama pull qwen2.5vl:3b
VISION_PROVIDER=ollama
VISION_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://127.0.0.1:11434

# Frontend origins, comma-separated. Add the exact HTTPS origin only when deployed.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
