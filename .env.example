# Copy to .env (git-ignored). Never commit real keys.
# VISION_PROVIDER: one of mock | heuristic | ollama
# or a fallback chain, tried left to right, e.g.  ollama,heuristic
VISION_PROVIDER=mock
# Model name from the Ollama library (needed for ollama)
VISION_MODEL=
# Only for ollama (local)
OLLAMA_HOST=http://localhost:11434

# Scan-aware Q&A via Ollama
VISION_QA_MODEL=qwen2.5vl:3b
OLLAMA_HOST=http://127.0.0.1:11434
# Comma-separated exact frontend origins; set your deployed HTTPS origin for public demo
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
