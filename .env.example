# Copy to .env (git-ignored). Never commit real keys.
# VISION_PROVIDER: one of mock | heuristic | ollama | gemini | openai | anthropic
# or a fallback chain, tried left to right, e.g.  ollama,heuristic
VISION_PROVIDER=mock
VISION_API_KEY=
# Model name from the provider's current docs (needed for ollama and cloud providers)
VISION_MODEL=
# Only for ollama (local)
OLLAMA_HOST=http://localhost:11434
